# ---------------------------------------------------------------------------
# costingly configuration
#
# Copy to .env and fill in.  .env is gitignored — never commit real secrets.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Plaid credentials -----------------------------------------------------
# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# Which Plaid environment to talk to: "production" or "sandbox".
# Defaults to "production" if unset. Use "sandbox" to test the whole flow
# against fake data first (log in with user_good / pass_good).
# NOTE: sandbox and production have DIFFERENT secrets, and access_tokens are
# not portable between them. If you switch environments, re-run `npm run link`.
PLAID_ENV=production

# --- Database (optional) ---------------------------------------------------
# LEAVE THIS UNSET for normal use.
#
# With no DATABASE_URL the app runs an embedded Postgres (PGlite) stored under
#   ~/.local/share/costingly/pgdata
# Nothing to install, no server, no port. This is the default and what most
# people want.
#
# Set it only to use a real Postgres server instead — e.g. a hosted serverless
# database for a Vercel deployment. Use the POOLED connection string:
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require
# SSL is enabled automatically whenever the host is not localhost.
#
# Override where the embedded database is stored:
# COSTINGLY_DATA_DIR=/path/to/data

# --- Encryption ------------------------------------------------------------
# 32 random bytes, base64-encoded. Generate one with:  npm run keygen
# Plaid access_tokens are encrypted at rest with AES-256-GCM using this key.
# If you lose this key you cannot decrypt stored tokens and must re-link every
# bank. Back it up somewhere safe (a password manager).
ENCRYPTION_KEY=

# --- Cron auth -------------------------------------------------------------
# Shared secret for the /api/sync route once deployed. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. Any long random string works:
#   openssl rand -base64 32
CRON_SECRET=

# --- Optional --------------------------------------------------------------
# Port for the local Plaid Link server (`npm run link`). Defaults to 4000.
# PORT=4000
