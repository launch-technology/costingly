{
  "name": "plaid-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Daily sync of bank and credit-card transactions from Plaid into Postgres.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "plaid-sync": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "schema.sql",
    "public",
    ".env.example"
  ],
  "scripts": {
    "build": "npm run clean && tsc && chmod +x dist/cli/index.js",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "cli": "tsx cli/index.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@electric-sql/pglite": "^0.5.4",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "plaid": "^45.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.3",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3"
  }
}
