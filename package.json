{
  "name": "costingly",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "description": "Daily sync of bank and credit-card transactions from Plaid into Postgres.",
  "license": "MIT",
  "author": "Jonathan Komorek",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "costingly": "./dist/apps/cli/main.js"
  },
  "files": [
    "dist",
    "migrations",
    "public"
  ],
  "scripts": {
    "build": "npm run clean && tsc && node -e \"require('fs').chmodSync('dist/apps/cli/main.js',0o755)\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.platform.json && tsc --noEmit -p tsconfig.domain.json",
    "cli": "tsx src/apps/cli/main.ts",
    "setup:sandbox": "tsx scripts/setup-sandbox.mts",
    "test": "tsx tests/run.mts",
    "build:bundle": "tsx scripts/build-bundle.mts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "plaid": "^45.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.3",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "^18.4.0-beta.17",
    "@embedded-postgres/darwin-x64": "^18.4.0-beta.17",
    "@embedded-postgres/linux-arm": "^18.4.0-beta.17",
    "@embedded-postgres/linux-arm64": "^18.4.0-beta.17",
    "@embedded-postgres/linux-ia32": "^18.4.0-beta.17",
    "@embedded-postgres/linux-ppc64": "^18.4.0-beta.17",
    "@embedded-postgres/linux-x64": "^18.4.0-beta.17",
    "@embedded-postgres/windows-x64": "^18.4.0-beta.17"
  }
}
