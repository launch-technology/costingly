{
  "name": "costingly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Daily sync of bank and credit-card transactions from Plaid into Postgres.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "costingly": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "schema.sql",
    "public"
  ],
  "scripts": {
    "build": "npm run clean && tsc && chmod +x dist/cli/index.js",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "cli": "tsx cli/index.ts",
    "setup:sandbox": "tsx scripts/setup-sandbox.mts",
    "test": "tsx tests/run.mts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "plaid": "^45.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.3",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "^18.4.0-beta.17",
    "@embedded-postgres/darwin-x64": "^18.4.0-beta.17",
    "@embedded-postgres/linux-arm": "^18.4.0-beta.17",
    "@embedded-postgres/linux-arm64": "^18.4.0-beta.17",
    "@embedded-postgres/linux-ia32": "^18.4.0-beta.17",
    "@embedded-postgres/linux-ppc64": "^18.4.0-beta.17",
    "@embedded-postgres/linux-x64": "^18.4.0-beta.17",
    "@embedded-postgres/windows-x64": "^18.4.0-beta.17"
  }
}
