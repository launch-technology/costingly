{
  "name": "plaid-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Daily sync of bank and credit-card transactions from Plaid into Postgres.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "tsx scripts/migrate.ts",
    "link": "tsx scripts/link-server.ts",
