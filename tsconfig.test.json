{
  // Typecheck the test suites and dev scripts without emitting them.
  //
  // They are deliberately outside the main tsconfig's `include`: that config
  // emits to dist/, and dist/ is what `files` publishes. Tests have no business
  // in the tarball, but they should still typecheck.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Nothing is emitted here, so the main config's rootDir — src/, which is
    // what keeps the published dist/ flat — would serve only to reject tests/
    // and scripts/ for sitting outside it.
    "rootDir": "."
  },
  "include": ["tests/**/*.mts", "scripts/**/*.mts", "src/**/*.ts"]
}
