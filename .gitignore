# costingly profiles — config.json, the Postgres cluster, socket and log.
# Everything costingly owns lives in one folder per environment, and none of it
# is committable.
.dev/
.dev-sandbox/
# The desktop app's own folder sits beside a moved profile with this suffix.
.dev-desktop/
.dev-sandbox-desktop/

# An optional convenience for setting environment variables in development.
# costingly never writes this and never stores credentials in it.
.env
.env.*
!.env.example
!.env.sandbox.example

# Dependencies
node_modules/

# Build output
dist/

# TypeScript's incremental caches, written by the composite configs in
# `npm run typecheck`. They are content hashes of every file in the program,
# including node_modules — so they churn on every dependency bump and turn a
# clean diff into a noisy one. tsBuildInfoFile points them at node_modules/
# already; this catches stale checkouts that still have them in the root.
*.tsbuildinfo

# The packed .mcpb and its staging directory.
build/
.next/
.vercel/

# Epic and story planning documents written by the epic-runner skill. Local
# working notes, not part of the published repo.
.epics/

# Logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
.idea/
.vscode/
