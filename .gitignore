# costingly profiles — config.json, the Postgres cluster, socket and log.
# Everything costingly owns lives in one folder per environment, and none of it
# is committable.
.dev/
.dev-sandbox/

# An optional convenience for setting environment variables in development.
# costingly never writes this and never stores credentials in it.
.env
.env.*
!.env.example
!.env.sandbox.example

# Dependencies
node_modules/

# Build output
dist/

# The packed .mcpb and its staging directory — ~317 MB, never committed.
build/
.next/
.vercel/

# Logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
.idea/
.vscode/
