# ---------------------------------------------------------------------------
# costingly — sandbox configuration (development and tests only)
#
# Copy to .env.sandbox and fill in.  .env.sandbox is gitignored.
#   cp .env.sandbox.example .env.sandbox
#
# Sandbox is NOT a product feature. Users only ever run against production;
# there is no PLAID_ENV in the normal .env at all. This file exists so that
# the end-to-end test — and anyone contributing — can exercise the real Plaid
# API against fake institutions without touching real accounts or paying for
# Items.
#
# Nothing here is read unless something asks for it explicitly:
#   the e2e suite loads this file by path
#   costingly --config .env.sandbox <command>    (works, not yet documented)
# ---------------------------------------------------------------------------

# Sandbox's whole reason for existing. Never set this in your real .env.
PLAID_ENV=sandbox

# From https://dashboard.plaid.com/developers/keys
# The client_id is the SAME as production; only the secret differs.
PLAID_CLIENT_ID=
PLAID_SECRET=

# Throwaway — this only ever encrypts sandbox access tokens, which are
# worthless. Generate one with:  costingly keygen
# Deliberately NOT your real key: sandbox should never be able to decrypt
# anything belonging to your production data.
ENCRYPTION_KEY=

# Throwaway. Unused locally; present so the config is complete.
CRON_SECRET=sandbox-not-a-real-secret

# The important isolation line: sandbox gets its own database, so a sandbox
# run can never read or write your real transactions. Use an absolute path.
COSTINGLY_DATA_DIR=/tmp/costingly-sandbox/pgdata
