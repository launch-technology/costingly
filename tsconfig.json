{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    // Emit is on: `npm run build` is a bare `tsc`. `npm run typecheck` passes
    // --noEmit explicitly, so editors and CI still get a check-only run.
    "rootDir": "src",
    "outDir": "dist",

    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  // tests/ and scripts/ are typechecked separately by tsconfig.test.json, which
  // sets noEmit. They must not be emitted here, because dist/ is what `files`
  // publishes.
  "include": ["src/**/*.ts"],
  // "dist" is required, not cosmetic: tsc only auto-excludes outDir when
  // `exclude` is absent entirely, and this config specifies it.
  "exclude": ["node_modules", "dist"]
}
